# Copia este contenido en Streamlit Community Cloud: tu app > Settings > Secrets
# (en tu computadora, guárdalo como .streamlit/secrets.toml; ese archivo no se sube a GitHub).

[onedrive]
# Vínculo para compartir el Excel (OneDrive > Compartir > Copiar vínculo)
link = "https://TU-EMPRESA-my.sharepoint.com/:x:/g/personal/..."

# Cada cuántos minutos se vuelve a descargar el Excel (opcional, 10 por omisión)
minutos = 10

# Solo si tu organización NO permite vínculos públicos ("Cualquier persona con el vínculo").
# Lo da el área de TI al registrar una aplicación en Microsoft Entra ID con el permiso
# de aplicación Files.Read.All (o Sites.Read.All) y consentimiento de administrador.
# tenant_id = ""
# client_id = ""
# client_secret = ""
